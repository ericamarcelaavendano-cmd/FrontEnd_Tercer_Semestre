## 7. Servicio de cursos: `courseService.js`

```js
import { supabase } from '../config/supabase'

export async function getCourses() {
  const { data, error } = await supabase
    .from('courses')
    .select('*')
    .order('created_at', { ascending: false })

  if (error) {
    console.error('Error al obtener cursos:', error.message)
    return []
  }

  return data
}

export async function buscarCursosPorNombre(texto) {
  const { data, error } = await supabase
    .from('courses')
    .select('*')
    .or(`name.ilike.%${texto}%,code.ilike.%${texto}%`)
    .order('created_at', { ascending: false })

  if (error) {
    console.error('Error al buscar cursos:', error.message)
    return []
  }

  return data
}
```

Estructura idéntica a `studentService.js` (Clase 02), reforzando el patrón repetible de servicios: listar todo, y buscar con coincidencia parcial.

